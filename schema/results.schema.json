{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marktoadvine/accessibility-fieldnote-schema/main/schema/results.schema.json",
  "title": "AFS verification results 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "fieldnote": {
      "type": "string",
      "minLength": 1
    },
    "componentRevision": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "inconclusive"
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "configuration": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Exactly one tested configuration. Required by linked validation when the fieldnote declares configurations; no wildcard or implied coverage."
          }
        },
        "required": [
          "check",
          "outcome",
          "observedAt",
          "environment",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "fieldnote",
    "componentRevision",
    "results"
  ]
}
