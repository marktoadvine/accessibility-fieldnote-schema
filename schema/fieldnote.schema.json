{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marktoadvine/accessibility-fieldnote-schema/main/schema/fieldnote.schema.json",
  "title": "Accessibility Fieldnote Schema 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "const": "0.2.0"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "const": "web"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "design": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "name",
        "platform"
      ]
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "profile",
        "version"
      ],
      "description": "Optional provenance for an authoring aid, not a mandatory checklist or completeness claim."
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "topic": {
            "enum": [
              "semantics",
              "keyboard",
              "focus",
              "content",
              "visual",
              "motion",
              "state",
              "other"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "description": "Optional authoring prompt. A decision can record behavior directly without a question."
          },
          "status": {
            "enum": [
              "open",
              "decided",
              "not-applicable"
            ]
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "standard": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "criterion": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "standard",
                "version",
                "url"
              ]
            }
          },
          "appliesTo": {
            "$ref": "#/$defs/appliesTo"
          }
        },
        "required": [
          "id",
          "topic",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "decided"
                }
              }
            },
            "then": {
              "required": [
                "answer"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not-applicable"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ]
      }
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "owner": {
            "enum": [
              "designer",
              "implementer",
              "consumer"
            ]
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "appliesTo": {
            "$ref": "#/$defs/appliesTo"
          }
        },
        "required": [
          "id",
          "owner",
          "requirement"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "workaround": {
            "type": "string",
            "minLength": 1
          },
          "appliesTo": {
            "$ref": "#/$defs/appliesTo"
          }
        },
        "required": [
          "id",
          "description"
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "decisions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "method": {
            "enum": [
              "manual",
              "automated",
              "assisted"
            ]
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          },
          "test": {
            "type": "string",
            "minLength": 1
          },
          "appliesTo": {
            "$ref": "#/$defs/appliesTo"
          }
        },
        "required": [
          "id",
          "decisions",
          "method",
          "procedure"
        ]
      }
    },
    "benchmarks": {
      "type": "array",
      "description": "Optional record-level sources informing decisions; not a coverage or conformance claim.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "version",
          "url"
        ]
      }
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "description": "Named, explicitly documented configurations. This list does not assert complete coverage of every possible combination.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z][a-zA-Z0-9-]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Human-readable configuration facts such as variant, state, theme, or colorMode. Informational; selection matches configuration IDs only."
          }
        }
      }
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "component",
    "decisions",
    "responsibilities",
    "limitations",
    "checks"
  ],
  "$defs": {
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "Configuration IDs this item covers. Omit to apply to every declared configuration. Items are additive; there are no overrides."
    }
  }
}
